# Server-side configuration. Set real values in Vercel Project Settings.
# Never commit .env.local or real credentials.
GEMINI_API_KEY=replace_with_your_gemini_api_key
APP_URL=http://localhost:3000
NUBRA_API_BASE_URL=https://api.nubra.io
NUBRA_AUTH_TOKEN=
NUBRA_DEVICE_ID=

# Stateless encrypted Nubra broker sessions (server-only; random secret, 32+ characters)
BROKER_SESSION_SECRET=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
ALERT_EMAIL_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_WEBHOOK_URL=
ALERT_SMS_API_KEY=
